# MongoDB Atlas connection string. Leave empty to run with in-memory stats (lost on restart).
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=wordswitch

# Comma-separated list of sites allowed to connect, e.g. your Vercel URL. * allows any.
CLIENT_ORIGINS=https://your-app.vercel.app,http://localhost:5173

# Render sets PORT itself.
# PORT=3001
